# PostgreSQL required for accounts, jobs, keys and observation history.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
CRON_SECRET=
RUNPOD_API_KEY=
VAST_API_KEY=
LAMBDA_API_KEY=
# Explicit allowlist of wallets allowed to spend the operator's provider credit.
PROVISIONING_WALLETS=
ENABLE_PROVISIONING=false
# Visitors may launch using only their own encrypted, wallet-scoped Vast.ai key.
ENABLE_SELF_SERVICE=false
# Default is Robinhood Chain mainnet, verified against official documentation.
NEXT_PUBLIC_CHAIN_NETWORK=mainnet
ROBINHOOD_RPC_URL=
# Configure a HTTPS scheduler to call /api/cron every minute before enabling jobs.
SCHEDULER_ENABLED=false
# 32 random bytes as 64 hex characters. Encrypts webhook signing secrets at rest.
WEBHOOK_ENCRYPTION_KEY=
